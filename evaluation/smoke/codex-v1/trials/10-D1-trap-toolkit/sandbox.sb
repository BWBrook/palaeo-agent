(version 1)
(allow default)
(deny file-read* (subpath "/Users/bwbrook"))
(allow file-read-metadata (literal "/Users/bwbrook") (literal "/Users"))
(allow file-read* (subpath "/Users/bwbrook/palaeo-eval/t/<trial>"))
(allow file-read* (subpath "/Users/bwbrook/palaeo-eval/runtime/toolkit"))
(allow file-read* (subpath "/Users/bwbrook/.local/share/uv/python"))
(allow file-read* (subpath "/Users/bwbrook/Library/Keychains"))
(allow file-read* (subpath "/Users/bwbrook/Library/Preferences"))
(allow file-read-metadata (literal "/Users/bwbrook"))
(allow file-read-metadata (literal "/Users/bwbrook/.local"))
(allow file-read-metadata (literal "/Users/bwbrook/.local/share"))
(allow file-read-metadata (literal "/Users/bwbrook/.local/share/uv"))
(allow file-read-metadata (literal "/Users/bwbrook/Library"))
(allow file-read-metadata (literal "/Users/bwbrook/palaeo-eval"))
(allow file-read-metadata (literal "/Users/bwbrook/palaeo-eval/runtime"))
(allow file-read-metadata (literal "/Users/bwbrook/palaeo-eval/t"))
(deny file-read* (subpath "/Users/Shared"))
(deny file-read* (subpath "/Volumes"))
(deny file-read* (subpath "/private/tmp"))
(deny file-read* (subpath "/private/var/folders"))
(deny file-read* (subpath "/opt/homebrew/bin/python3.14"))
(deny file-read* (subpath "/opt/homebrew/bin/pip3.14"))
(deny file-read* (subpath "/opt/homebrew/Cellar/python@3.14"))
(deny file-read* (subpath "/opt/homebrew/lib/python3.14"))
(deny file-read* (subpath "/opt/homebrew/Frameworks/Python.framework"))
(deny file-read* (subpath "/opt/homebrew/bin/R"))
(deny file-read* (subpath "/opt/homebrew/bin/Rscript"))
(deny file-read* (subpath "/opt/homebrew/Cellar/r"))
(deny file-read* (subpath "/opt/homebrew/lib/R"))
(deny file-read* (subpath "/Library/Frameworks/R.framework"))
(allow file-read* (subpath "/Users/bwbrook/palaeo-eval/t/<trial>"))
(deny file-write* (subpath "/"))
(allow file-write* (literal "/dev/null") (literal "/dev/tty") (literal "/dev/dtracehelper") (regex #"^/dev/fd/") (regex #"^/dev/ttys"))
(allow file-write* (subpath "/Users/bwbrook/palaeo-eval/t/<trial>"))
