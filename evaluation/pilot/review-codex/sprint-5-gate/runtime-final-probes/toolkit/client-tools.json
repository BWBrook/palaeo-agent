  {
    "name": "palaeo_study_run",
    "title": null,
    "description": "Run a multi-step study: declared exclusions, selections and taxon mappings, then analyses; saves one bundle.",
    "inputSchema": {
      "properties": {
        "study": {
          "$ref": "#/$defs/StudySpec"
        },
        "output": {
          "description": "New directory for the study bundle",
          "minLength": 1,
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "study",
        "output"
      ],
      "type": "object",
      "$defs": {
        "Analysis": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Id",
              "type": "string"
            },
            "dataset": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Dataset",
              "type": "string"
            },
            "spec": {
              "additionalProperties": true,
              "description": "A method specification without input or metadata paths",
              "title": "Spec",
              "type": "object"
            }
          },
          "required": [
            "id",
            "dataset",
            "spec"
          ],
          "title": "Analysis",
          "type": "object"
        },
        "Dataset": {
          "additionalProperties": false,
          "properties": {
            "source": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Source",
              "type": "string"
            },
            "metadata": {
              "anyOf": [
                {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9_.-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Metadata"
            },
            "drop_unmatched_metadata": {
              "default": false,
              "description": "Allow metadata rows whose IDs are absent from the dataset; they are listed",
              "title": "Drop Unmatched Metadata",
              "type": "boolean"
            },
            "operations": {
              "default": [],
              "items": {
                "discriminator": {
                  "mapping": {
                    "exclude": "#/$defs/Exclude",
                    "map_taxa": "#/$defs/MapTaxa",
                    "select": "#/$defs/Select"
                  },
                  "propertyName": "op"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Exclude"
                  },
                  {
                    "$ref": "#/$defs/Select"
                  },
                  {
                    "$ref": "#/$defs/MapTaxa"
                  }
                ]
              },
              "title": "Operations",
              "type": "array"
            }
          },
          "required": [
            "source"
          ],
          "title": "Dataset",
          "type": "object"
        },
        "Exclude": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "exclude",
              "title": "Op",
              "type": "string"
            },
            "samples": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Samples",
              "type": "array"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "op",
            "samples",
            "reason"
          ],
          "title": "Exclude",
          "type": "object"
        },
        "MapTaxa": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "map_taxa",
              "title": "Op",
              "type": "string"
            },
            "mapping": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Exact old label -> new label; equal targets are summed",
              "minProperties": 1,
              "title": "Mapping",
              "type": "object"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "op",
            "mapping",
            "reason"
          ],
          "title": "MapTaxa",
          "type": "object"
        },
        "MetadataInput": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "metadata",
              "title": "Kind",
              "type": "string"
            },
            "path": {
              "description": "UTF-8 CSV; relative to the study file",
              "format": "path",
              "title": "Path",
              "type": "string"
            },
            "id_column": {
              "description": "Exact column holding sample IDs",
              "minLength": 1,
              "title": "Id Column",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "id_column"
          ],
          "title": "MetadataInput",
          "type": "object"
        },
        "Select": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "select",
              "title": "Op",
              "type": "string"
            },
            "samples": {
              "description": "Samples kept, in this order",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Samples",
              "type": "array"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "op",
            "samples",
            "reason"
          ],
          "title": "Select",
          "type": "object"
        },
        "StudySpec": {
          "additionalProperties": false,
          "properties": {
            "study_version": {
              "const": 1,
              "title": "Study Version",
              "type": "integer"
            },
            "inputs": {
              "patternProperties": {
                "^[A-Za-z0-9_.-]+$": {
                  "discriminator": {
                    "mapping": {
                      "counts": "#/$defs/TableInput",
                      "measurements": "#/$defs/TableInput",
                      "metadata": "#/$defs/MetadataInput"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/TableInput"
                    },
                    {
                      "$ref": "#/$defs/MetadataInput"
                    }
                  ]
                }
              },
              "propertyNames": {
                "minLength": 1
              },
              "title": "Inputs",
              "type": "object"
            },
            "datasets": {
              "patternProperties": {
                "^[A-Za-z0-9_.-]+$": {
                  "$ref": "#/$defs/Dataset"
                }
              },
              "propertyNames": {
                "minLength": 1
              },
              "title": "Datasets",
              "type": "object"
            },
            "analyses": {
              "items": {
                "$ref": "#/$defs/Analysis"
              },
              "minItems": 1,
              "title": "Analyses",
              "type": "array"
            }
          },
          "required": [
            "study_version",
            "inputs",
            "datasets",
            "analyses"
          ],
          "title": "StudySpec",
          "type": "object"
        },
        "TableInput": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "counts",
                "measurements"
              ],
              "title": "Kind",
              "type": "string"
            },
            "path": {
              "description": "Table path, relative to the study file",
              "format": "path",
              "title": "Path",
              "type": "string"
            },
            "format": {
              "default": "past",
              "description": "'past': classic PAST table, first header cell '.', tab-separated (whitespace if the file has no tabs). 'delimited': tab- or comma-separated with a declared delimiter; the first header cell names the ID column. Empty and NA cells are missing counts.",
              "enum": [
                "past",
                "delimited"
              ],
              "title": "Format",
              "type": "string"
            },
            "delimiter": {
              "anyOf": [
                {
                  "enum": [
                    "tab",
                    "comma"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Required for format 'delimited'",
              "title": "Delimiter"
            },
            "orientation": {
              "description": "Declared layout; derived datasets are always samples_by_taxa",
              "enum": [
                "samples_by_taxa",
                "taxa_by_samples"
              ],
              "title": "Orientation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "orientation"
          ],
          "title": "TableInput",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "title": "StudyRunRequest"
    },
    "execution": null,
    "outputSchema": null,
    "icons": null,
    "annotations": null,
    "_meta": null
  },
