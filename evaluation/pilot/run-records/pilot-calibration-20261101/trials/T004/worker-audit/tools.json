[
  {
    "name": "worker_execute",
    "description": "Execute Python in the trial. No network, subprocesses, credentials or outside files. Installed scientific packages are available.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "worker_read",
    "description": "Read a UTF-8 trial file in a bounded page; paths are relative to the trial root.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "default": 32768
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "worker_write",
    "description": "Write a UTF-8 trial file; paths are relative to the trial root.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        }
      },
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "palaeo_discover",
    "description": "List method summaries, or request one method's complete typed schemas.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "anyOf": [
            {
              "enum": [
                "rma",
                "community",
                "permanova"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "title": "DiscoverRequest",
      "type": "object"
    }
  },
