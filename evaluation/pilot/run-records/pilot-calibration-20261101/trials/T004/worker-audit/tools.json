  {
    "name": "palaeo_study_run",
    "description": "Run a multi-step study: declared exclusions, selections and taxon mappings, then analyses; saves one bundle.",
    "inputSchema": {
      "$defs": {
        "Analysis": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Id",
              "type": "string"
            },
            "dataset": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Dataset",
              "type": "string"
            },
            "spec": {
              "additionalProperties": true,
              "description": "A method specification without input or metadata paths",
              "title": "Spec",
              "type": "object"
            }
          },
          "required": [
            "id",
            "dataset",
            "spec"
          ],
          "title": "Analysis",
          "type": "object"
        },
        "Dataset": {
          "additionalProperties": false,
          "properties": {
            "source": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "title": "Source",
              "type": "string"
            },
            "metadata": {
              "anyOf": [
                {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9_.-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Metadata"
            },
            "drop_unmatched_metadata": {
              "default": false,
              "description": "Allow metadata rows whose IDs are absent from the dataset; they are listed",
              "title": "Drop Unmatched Metadata",
              "type": "boolean"
            },
            "operations": {
              "default": [],
              "items": {
                "discriminator": {
                  "mapping": {
                    "exclude": "#/$defs/Exclude",
                    "map_taxa": "#/$defs/MapTaxa",
                    "select": "#/$defs/Select"
                  },
                  "propertyName": "op"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Exclude"
                  },
                  {
                    "$ref": "#/$defs/Select"
                  },
                  {
                    "$ref": "#/$defs/MapTaxa"
                  }
                ]
              },
              "title": "Operations",
              "type": "array"
            }
          },
          "required": [
            "source"
          ],
          "title": "Dataset",
          "type": "object"
        },
        "Exclude": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "exclude",
              "title": "Op",
              "type": "string"
            },
            "samples": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Samples",
              "type": "array"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "op",
            "samples",
            "reason"
          ],
          "title": "Exclude",
          "type": "object"
        },
        "MapTaxa": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "map_taxa",
              "title": "Op",
              "type": "string"
            },
            "mapping": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Exact old label -> new label; equal targets are summed",
              "minProperties": 1,
              "title": "Mapping",
              "type": "object"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "op",
            "mapping",
            "reason"
          ],
          "title": "MapTaxa",
          "type": "object"
        },
        "MetadataInput": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "metadata",
              "title": "Kind",
              "type": "string"
            },
            "path": {
              "description": "UTF-8 CSV; relative to the study file",
              "format": "path",
              "title": "Path",
              "type": "string"
            },
            "id_column": {
