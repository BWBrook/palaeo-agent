{
  "study_version": 1,
  "inputs": {
    "counts": {
      "kind": "counts",
      "path": "inputs/counts",
      "format": "delimited",
      "delimiter": "tab",
      "orientation": "samples_by_taxa"
    }
  },
  "datasets": {
    "acc": {
      "source": "counts",
      "metadata": null,
      "drop_unmatched_metadata": false,
      "operations": [
        {
          "op": "map_taxa",
          "mapping": {
            "Globigerinoides sacculifer": "Trilobatus sacculifer",
            "Globigerinoides tenellus": "Globoturborotalita tenella",
            "Neogloboquadrina pachyderma (dextral)": "Neogloboquadrina incompta",
            "Neogloboquadrina pachyderma (sinistral)": "Neogloboquadrina pachyderma"
          },
          "reason": "Rename to accepted names (taxonomy.csv); synonyms summed"
        }
      ]
    }
  },
  "analyses": [
    {
      "id": "bc",
      "dataset": "acc",
      "spec": {
        "method": "community",
        "value_type": "count",
        "transform": "none",
        "distance": "braycurtis",
        "dimensions": 2,
        "missing": "error",
        "empty_samples": "error",
        "format": "past",
        "orientation": "samples_by_taxa"
      }
    }
  ]
}
