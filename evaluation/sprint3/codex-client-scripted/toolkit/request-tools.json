[
  {
    "type": "function",
    "name": "list_mcp_resources",
    "description": "Lists resources provided by MCP servers. Resources allow servers to share data that provides context to language models, such as files, database schemas, or application-specific information. Prefer resources over web search when possible.",
    "strict": false,
    "parameters": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from a previous list_mcp_resources call; omit for the first page."
        },
        "server": {
          "type": "string",
          "description": "MCP server name. Omit to list resources from every configured server."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "list_mcp_resource_templates",
    "description": "Lists resource templates provided by MCP servers. Parameterized resource templates allow servers to share data that takes parameters and provides context to language models, such as files, database schemas, or application-specific information. Prefer resource templates over web search when possible.",
    "strict": false,
    "parameters": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from a previous list_mcp_resource_templates call; omit for the first page."
        },
        "server": {
          "type": "string",
          "description": "MCP server name. Omit to list resource templates from every configured server."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_mcp_resource",
    "description": "Read a specific resource from an MCP server given the server name and resource URI.",
    "strict": false,
    "parameters": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "description": "MCP server name exactly as configured. Must match the 'server' field returned by list_mcp_resources."
        },
        "uri": {
          "type": "string",
          "description": "Resource URI to read. Must be one of the URIs returned by list_mcp_resources."
        }
      },
      "required": [
        "server",
        "uri"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "namespace",
    "name": "mcp__worker",
    "description": "Tools in the mcp__worker namespace.",
    "tools": [
      {
        "type": "function",
        "name": "palaeo_compare",
        "description": "Compare community runs descriptively under the existing provenance and one-factor rules.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "baseline": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "sensitivity": {
              "type": "string"
            }
          },
          "required": [
            "baseline",
            "sensitivity"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "palaeo_discover",
        "description": "List method summaries, or request one method's complete typed schemas.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "method": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "rma",
                    "community",
                    "permanova"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "palaeo_inspect",
        "description": "Verify a run's integrity and return a compact summary, field names and artifact references.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "bundle": {
              "type": "string"
            }
          },
          "required": [
            "bundle"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "palaeo_inspect_comparison",
        "description": "Verify a descriptive comparison and both embedded run bundles.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "bundle": {
              "type": "string"
            }
          },
          "required": [
            "bundle"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "palaeo_reproduce",
        "description": "Recompute a saved bundle and compare its numerical outputs.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "bundle": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "bundle"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "function",
        "name": "palaeo_result",
        "description": "Read one verified run-result field, with bounded rows and matrix columns.",
        "strict": false,
        "parameters": {
          "type": "object",
          "properties": {
            "bundle": {
              "type": "string"
            },
            "column_limit": {
              "type": "integer"
            },
            "column_offset": {
              "type": "integer"
            },
            "field": {
              "type": "string",
              "description": "Dot-separated result-field path; discover fields with inspect"
            },
            "limit": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            }
          },
          "required": [
            "bundle",
            "field"
          ],
          "additionalProperties": false
        }
      },
