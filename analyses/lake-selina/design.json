 "reporting_rules": {
  "primary_p": "API plus-one Monte Carlo p-values and their API Holm adjustment across all 77 pairs; taxon tests in the API's global pair x taxon Holm family; the two families do not jointly control one error rate",
  "monte_carlo_sensitivity": "apply Holm separately to the 77 lower and the 77 upper Clopper-Pearson bounds of the exact conditional tail probabilities; flag pair i when Holm(lower)[i] <= 0.05 <= Holm(upper)[i]; a sensitivity envelope, not a simultaneous interval or a new significance rule (unsupported postprocessing)",
  "ranks": "rank the 71 adjacent steps by proportional Bray-Curtis among themselves; report the three primary long-interval comparisons separately, each beside its IPPD-1 sensitivity pair; no pooled rank over 77 pairs",
  "direction": "pairs run shallow/younger (a) to deep/older (b); the API taxon effect is b - a; forward-time change is reported as younger minus older = -(b - a), labelled with both sample IDs",
  "no_reruns": "B and seed fixed; no rerun for significance"
 },
